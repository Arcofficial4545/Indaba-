# Every environment variable the codebase reads. Copy to .env.local for local
# development, and set the same names in the host's environment for deploys.
# No real values belong in this file.
#
# NODE_ENV and VERCEL_ENV are also read, but Next.js and Vercel set them. Do
# not set either here.

# =============================================================================
# Public. Inlined into the browser bundle at build time.
# =============================================================================

# Supabase project URL. Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Browser safe; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin for URLs, sitemap and OG images. No trailing slash.
# Falls back to https://indaba-one.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# Server only. Never prefix these with NEXT_PUBLIC_.
# =============================================================================

# Supabase service role key. Bypasses RLS. Rotate immediately if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pepper for IP hashes, required for the POPIA anonymisation claim.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_PEPPER=

# --- Email (optional) ---------------------------------------------------------
# Two transports. SMTP is used when SMTP_USER and SMTP_PASSWORD are both set;
# otherwise Resend is used when RESEND_API_KEY and EMAIL_FROM are set. See
# docs/operations/deployment.md.

# Interim transport while there is no verified domain: a Gmail address and its
# App Password (Google Account > Security > 2-Step Verification > App passwords).
# Emails are sent as "Indaba <SMTP_USER>".
SMTP_USER=
SMTP_PASSWORD=

# Optional overrides for a non-Gmail SMTP server. Default smtp.gmail.com and 465.
SMTP_HOST=
SMTP_PORT=

# Resend, once a domain is verified. Before that, Resend delivers only to the
# Resend account owner. Sender format: Indaba <newsletter@yourdomain>
RESEND_API_KEY=
EMAIL_FROM=

# =============================================================================
# Tooling only. Not read by the running site.
# =============================================================================

# Set to 1 to skip the lib/env.ts startup check, e.g. a local build with no
# Supabase project. Never set this on a real deploy.
SKIP_ENV_VALIDATION=

# Base URL for the screenshot scripts in scripts/ (shoot, measure-logos,
# make-logo-variant).
SHOOT_BASE=
