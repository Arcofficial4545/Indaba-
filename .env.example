# Every environment variable the codebase reads. Copy to .env.local for local
# development, and set the same names in the host's environment for deploys.
# No real values belong in this file.
#
# NODE_ENV and VERCEL_ENV are also read, but Next.js and Vercel set them. Do
# not set either here.

# =============================================================================
# Public. Inlined into the browser bundle at build time.
# =============================================================================

# Supabase project URL. Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Browser safe; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin for URLs, sitemap and OG images. No trailing slash.
# Falls back to https://indaba-one.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# Server only. Never prefix these with NEXT_PUBLIC_.
# =============================================================================

# Supabase service role key. Bypasses RLS. Rotate immediately if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pepper for IP hashes, required for the POPIA anonymisation claim.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_PEPPER=

# Resend API key for transactional email (newsletter confirmation). Optional.
# Without a verified domain, Resend delivers only to the account owner's own
# address, and the site tells everyone else confirmation is not switched on.
RESEND_API_KEY=

# Sender for transactional email. Set together with RESEND_API_KEY. Without a
# verified domain use: Indaba <onboarding@resend.dev>
EMAIL_FROM=

# =============================================================================
# Tooling only. Not read by the running site.
# =============================================================================

# Set to 1 to skip the lib/env.ts startup check, e.g. a local build with no
# Supabase project. Never set this on a real deploy.
SKIP_ENV_VALIDATION=

# Base URL for the screenshot scripts in scripts/ (shoot, measure-logos,
# make-logo-variant).
SHOOT_BASE=
